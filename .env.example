# Sao chép thành .env.development (dev) hoặc .env.production.local (build) rồi điền giá trị.

# Địa chỉ MAMCG.Backend (không có dấu / ở cuối)
VITE_API_URL=http://localhost:5080

# Địa chỉ frontend; cổng dùng cho `vite preview`
VITE_DOMAIN_URL=http://localhost:6060

# Bật log debug phía client
VITE_DEBUG_MODE=false

# Bật API giả lập (MSW) khi chạy dev, dùng khi không có backend
VITE_ENABLE_MOCKS=false
